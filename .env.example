# Copy to .env and fill in local values (never commit .env — it's gitignored).
#
# EPPO_API_KEY — required only for src/agml_agent/sources/eppo.py. Every other source
# is free and keyless.
#   1. Register at https://data.eppo.int/ui/#/user/register (free)
#   2. Log in at https://data.eppo.int/ui/#/user/login
#   3. Your account page has your API token — generate one if you don't have it yet
#   4. Paste it below.
# API docs (what the token unlocks): https://api.eppo.int/gd/v2 (REST v2, X-Api-Key header)
EPPO_API_KEY=your_eppo_api_key_here
